{
  "name": "notion-latex-autocomplete",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "webpack && web-ext build --source-dir=dist/ --artifacts-dir=dist/artifacts/ --overwrite-dest",
    "clean": "rm -r dist/",
    "sign-and-release": "cd dist/ && web-ext sign --channel listed -v --artifacts-dir=artifacts/ --amo-metadata=../metadata.json",
    "build-and-sign-and-release": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^26.1.1",
    "@types/webextension-polyfill": "^0.12.4",
    "copy-webpack-plugin": "^14.0.0",
    "esbuild": "0.27.1",
    "eslint": "^9.39.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "web-ext": "^10.5.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "dependencies": {
    "katex": "^0.16.27",
    "prettier-plugin-latex": "^2.0.1",
    "webextension-polyfill": "^0.12.0"
  }
}
