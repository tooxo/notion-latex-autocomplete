{
  "name": "LaTeX Autocomplete for Notion",
  "author": "Till Schulte",
  "version": "1.1.1",
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "description": "Adds autocompletion to notion equation fields.",
  "content_scripts": [
    {
      "matches": [
        "https://notion.so/*",
        "https://www.notion.so/*"
      ],
      "js": [
        "autocomplete.js"
      ],
      "css": [
        "styles.css"
      ],
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://notion.so/*",
    "https://www.notion.so/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "not_lat_auto@tillschulte.de"
    }
  }
}